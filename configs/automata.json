[
  {
    "automaton_name": "register_profile_ig",
    "states": {
      "initial": "START",
      "final": ["DONE"]
    },
    "params": {},
    "transitions": [
      {
        "from": "START",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "profile_register",
              "params": ["env_id", "agent_id", "false"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "follow_random_ig",
    "states": {
      "initial": "SELECT_TARGENT",
      "final": ["DONE", "NO_TARGETS"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_TARGENT",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "profiles_not_followed"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "SEND_REQUEST",
            "update_params": {
              "target_id": { "type": "deterministic", "value": "random.choice(targets)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_TARGETS",
            "effect_order": []
          }
        ]
      },
      {
        "from": "SEND_REQUEST",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "follow_request",
              "params": ["env_id", "agent_id", "target_id"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "accept_pending_follows_ig",
    "states": {
      "initial": "CHECK_PENDING",
      "final": ["DONE", "NO_PENDING"]
    },
    "params": {},
    "transitions": [
      {
        "from": "CHECK_PENDING",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "pending_follow_requests"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "ACCEPT_ALL",
            "update_params": {
              "pending_list": { "type": "deterministic", "value": "pending" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_PENDING",
            "effect_order": []
          }
        ]
      },
      {
        "from": "ACCEPT_ALL",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "ACCEPT_ALL",
            "action_required": {
              "target": "environments",
              "method": "follow_accept",
              "params": ["env_id", "pending_list[0].from", "agent_id"]
            },
            "update_params": {
              "pending_list": { "type": "deterministic", "value": "pending_list[1:]" }
            },
            "effect_order": ["action_required", "update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "DONE",
            "effect_order": []
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "unfollow_random_ig",
    "states": {
      "initial": "SELECT_TO_FOLLOW",
      "final": ["DONE", "NO_FOLLOWING"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_TO_FOLLOW",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "following_list"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "UNFOLLOW",
            "update_params": {
              "to_unfollow": { "type": "deterministic", "value": "random.choice(following)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_FOLLOWING",
            "effect_order": []
          }
        ]
      },
      {
        "from": "UNFOLLOW",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "follow_reject",
              "params": ["env_id", "agent_id", "to_unfollow"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "interact_direct_ig",
    "states": {
      "initial": "SELECT_RECIPIENT",
      "final": ["DONE", "NO_AVAILABLE"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_RECIPIENT",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "available_contacts"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "INTERACT",
            "update_params": {
              "recipient": { "type": "deterministic", "value": "random.choice(contacts)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_AVAILABLE",
            "effect_order": []
          }
        ]
      },
      {
        "from": "INTERACT",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "direct_channels_interact",
              "params": ["env_id", "agent_id", "recipient"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  }
]