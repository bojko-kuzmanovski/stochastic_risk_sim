[
  {
    "automaton_name": "register_profile_ig",
    "states": {
      "initial": "START",
      "final": ["DONE_PUBLIC", "DONE_PRIVATE", "NO_MOOD", "DONE_ALREADY"]
    },
    "params": {
      "env_type": {
        "type": "deterministic",
        "value": "instagram"
      }
    },
    "transitions": [
      {
        "from": "START",
        "rule": {
          "type": "probabilistic",
          "distribution": "mood_register_env"
        },
        "thresholds": [
          {
            "threshold": "X > 0.5",
            "to": "CHECK_EXISTING",
            "update_params": {
              "env_ids": {
                "type": "logic",
                "query": {
                  "target": "environments",
                  "method": "get_env_ids_by_type",
                  "params": ["env_type"]
                }
              },
              "env_id": {
                "type": "deterministic",
                "value": "${env_ids[0]}"
              }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X <= 0.5",
            "to": "NO_MOOD",
            "effect_order": []
          }
        ]
      },
      {
        "from": "CHECK_EXISTING",
        "rule": {
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "profile_already_registered",
            "params": ["env_id", "agent_id"]
          }
        },
        "thresholds": [
          {
            "threshold": "X",
            "to": "DONE_ALREADY",
            "effect_order": []
          },
          {
            "threshold": "not X",
            "to": "DECIDE_PRIVACY",
            "effect_order": []
          }
        ]
      },
      {
        "from": "DECIDE_PRIVACY",
        "rule": {
          "type": "probabilistic",
          "distribution": "prefer_public_profile_env"
        },
        "thresholds": [
          {
            "threshold": "X > 0.5",
            "to": "PRIVACY_DECIDED",
            "update_params": {
              "public_profile": {
                "type": "deterministic",
                "value": true
              }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X <= 0.5",
            "to": "PRIVACY_DECIDED",
            "update_params": {
              "public_profile": {
                "type": "deterministic",
                "value": false
              }
            },
            "effect_order": ["update_params"]
          }
        ]
      },
      {
        "from": "PRIVACY_DECIDED",
        "rule": {
          "type": "deterministic",
          "value": "${public_profile}"
        },
        "thresholds": [
          {
            "threshold": "X",
            "to": "DONE_PUBLIC",
            "action_required": {
              "target": "environments",
              "method": "profile_register",
              "params": ["env_id", "agent_id", "public_profile"]
            },
            "effect_order": ["action_required"]
          },
          {
            "threshold": "not X",
            "to": "DONE_PRIVATE",
            "action_required": {
              "target": "environments",
              "method": "profile_register",
              "params": ["env_id", "agent_id", "public_profile"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },






  {
    "automaton_name": "follow_random_ig",
    "states": {
      "initial": "SELECT_TARGENT",
      "final": ["DONE", "NO_TARGETS"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_TARGENT",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "profiles_not_followed"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "SEND_REQUEST",
            "update_params": {
              "target_id": { "type": "deterministic", "value": "random.choice(targets)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_TARGETS",
            "effect_order": []
          }
        ]
      },
      {
        "from": "SEND_REQUEST",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "follow_request",
              "params": ["env_id", "agent_id", "target_id"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "accept_pending_follows_ig",
    "states": {
      "initial": "CHECK_PENDING",
      "final": ["DONE", "NO_PENDING"]
    },
    "params": {},
    "transitions": [
      {
        "from": "CHECK_PENDING",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "pending_follow_requests"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "ACCEPT_ALL",
            "update_params": {
              "pending_list": { "type": "deterministic", "value": "pending" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_PENDING",
            "effect_order": []
          }
        ]
      },
      {
        "from": "ACCEPT_ALL",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "ACCEPT_ALL",
            "action_required": {
              "target": "environments",
              "method": "follow_accept",
              "params": ["env_id", "pending_list[0].from", "agent_id"]
            },
            "update_params": {
              "pending_list": { "type": "deterministic", "value": "pending_list[1:]" }
            },
            "effect_order": ["action_required", "update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "DONE",
            "effect_order": []
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "unfollow_random_ig",
    "states": {
      "initial": "SELECT_TO_FOLLOW",
      "final": ["DONE", "NO_FOLLOWING"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_TO_FOLLOW",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "following_list"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "UNFOLLOW",
            "update_params": {
              "to_unfollow": { "type": "deterministic", "value": "random.choice(following)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_FOLLOWING",
            "effect_order": []
          }
        ]
      },
      {
        "from": "UNFOLLOW",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "follow_reject",
              "params": ["env_id", "agent_id", "to_unfollow"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  },
  {
    "automaton_name": "interact_direct_ig",
    "states": {
      "initial": "SELECT_RECIPIENT",
      "final": ["DONE", "NO_AVAILABLE"]
    },
    "params": {},
    "transitions": [
      {
        "from": "SELECT_RECIPIENT",
        "rule": { 
          "type": "logic",
          "query": {
            "target": "environments",
            "method": "get_param",
            "params": ["env_id", "available_contacts"]
          }
        },
        "thresholds": [
          {
            "threshold": "X > 0",
            "to": "INTERACT",
            "update_params": {
              "recipient": { "type": "deterministic", "value": "random.choice(contacts)" }
            },
            "effect_order": ["update_params"]
          },
          {
            "threshold": "X == 0",
            "to": "NO_AVAILABLE",
            "effect_order": []
          }
        ]
      },
      {
        "from": "INTERACT",
        "rule": { "type": "deterministic", "value": true },
        "thresholds": [
          {
            "threshold": "X == true",
            "to": "DONE",
            "action_required": {
              "target": "environments",
              "method": "direct_channels_interact",
              "params": ["env_id", "agent_id", "recipient"]
            },
            "effect_order": ["action_required"]
          }
        ]
      }
    ]
  }
]