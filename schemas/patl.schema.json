{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PATL Sampling Configuration",
  "type": "object",
  "required": ["observations"],
  "properties": {
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["automaton_name", "trigger_state", "predicates"],
        "properties": {
          "automaton_name": { "type": "string" },
          "trigger_state": { "type": "string" },
          "predicates": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/patl_predicate" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "patl_predicate": {
      "type": "object",
      "required": ["predicate_id", "type", "coalition", "probability_bound"],
      "properties": {
        "predicate_id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["reachability", "invariance"]
        },
        "max_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 20
        },
        "max_memory": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "coalition_quantifier": {
          "type": "string",
          "enum": ["exists", "forall"],
          "default": "exists"
        },
        "coalition": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/agent_coalition_target" }
        },
        "adversaries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/agent_coalition_target" }
        },
        "probability_bound": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "probability_operator": {
          "type": "string",
          "enum": ["<", "<=", ">", ">="],
          "default": ">="
        }
      },
      "additionalProperties": false
    },
    "agent_coalition_target": {
      "type": "object",
      "required": ["automata", "max_agents"],
      "properties": {
        "agent_type": { "type": "string" },
        "agent_id": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": { "type": "string" }
        },
        "max_agents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "automata": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/definitions/automaton_target" }
        }
      },
      "anyOf": [
        { "required": ["agent_type"] },
        { "required": ["agent_id"] }
      ],
      "additionalProperties": false
    },
    "automaton_target": {
      "type": "object",
      "required": ["automaton_name", "target_states"],
      "properties": {
        "automaton_name": { "type": "string" },
        "target_states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}