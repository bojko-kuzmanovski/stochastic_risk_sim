{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DistributionsFactory",
  "type": "array",
  "items": {
    "$ref": "#/definitions/distribution_entry"
  },
  "definitions": {
    "truncation_bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "distribution_entry": {
      "type": "object",
      "required": ["distribution_name", "family", "params", "output_type"],
      "additionalProperties": false,
      "properties": {
        "distribution_name": { "type": "string" },
        "family": {
          "enum": [
            "exponential",
            "poisson",
            "gamma",
            "beta",
            "lognormal",
            "normal",
            "categorical"
          ]
        },
        "output_type": { "enum": ["int", "float", "string"] },
        "params": { "type": "object" },
        "truncation": { "$ref": "#/definitions/truncation_bounds" }
      },
      "allOf": [
        {
          "if": { "properties": { "family": { "const": "exponential" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["rate"],
                "properties": {
                  "rate": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "poisson" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["lambda"],
                "properties": {
                  "lambda": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "gamma" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["shape", "scale"],
                "properties": {
                  "shape": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "beta" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["alpha", "beta"],
                "properties": {
                  "alpha": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "beta": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "lognormal" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["mean", "sigma"],
                "properties": {
                  "mean": { "type": "number" },
                  "sigma": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "normal" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["mean", "sigma"],
                "properties": {
                  "mean": { "type": "number" },
                  "sigma": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": { "properties": { "family": { "const": "categorical" } } },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "required": ["categories"],
                "properties": {
                  "categories": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": ["label", "probability"],
                      "additionalProperties": false,
                      "properties": {
                        "label": { "type": "string" },
                        "probability": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      }
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  }
}