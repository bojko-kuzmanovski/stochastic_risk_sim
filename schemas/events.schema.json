{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventsRegistry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["event_name", "event_category", "signal"],
    "properties": {
      "event_name": { "type": "string" },
      "event_category": { "enum": ["static", "dynamic"] },
      "signal": { "type": "string" }
    },   
    "if": {
      "properties": { "event_category": { "const": "static" } }
    },
    "then": {
      "required": ["agent_type", "periodicity"],
      "properties": {
        "agent_type": { "type": "string" },
        "periodicity": { "$ref": "#/definitions/periodicity_definition" }
      }
    },
    "else": {
      "required": ["from_agent", "to_agent", "created_at", "scheduled_for"],
      "properties": {
        "from_agent": {
          "type": "object",
          "required": ["agent_id", "agent_type"],
          "properties": {
            "agent_id": { "type": "string" },
            "agent_type": { "type": "string" },
            "metadata": { "type": "object", "additionalProperties": true }
          }
        },
        "to_agent": {
          "type": "object",
          "required": ["agent_id", "agent_type"],
          "properties": {
            "agent_id": { "type": "string" },
            "agent_type": { "type": "string" },
            "metadata": { "type": "object", "additionalProperties": true }
          }
        },
        "env": {
          "type": ["object", "null"],
          "required": ["env_id", "env_type"],
          "properties": {
            "env_id": { "type": "string" },
            "env_type": { "type": "string" }
          }
        },
        "created_at": { "type": "number" },
        "scheduled_for": { "type": "number", "minimum": 0 },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "definitions": {
    "periodicity_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "if": {
        "properties": { "type": { "const": "probabilistic" } }
      },
      "then": {
        "required": ["distribution"]
      },
      "else": {
        "required": ["value"]
      }
    }
  }
}