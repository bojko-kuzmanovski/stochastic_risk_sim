{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventsRegistry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["event_category", "signal"],
    "properties": {
      "event_category": { "enum": ["static", "dynamic"] },
      "signal": { "type": "string" }
    },   
    "if": {
      "properties": { "event_category": { "const": "static" } }
    },
    "then": {
      "required": ["agent_type", "periodicity"],
      "properties": {
        "agent_type": { "type": "string" },
        "periodicity": { "$ref": "#/definitions/periodicity_definition" }
      }
    },
    "else": {
      "required": ["created_at", "agent_id"],
      "properties": {
        "created_at": { "type": "number", "minimum": 0 },
        "agent_id": { "type": "string" },
        "env_id": { "type": "string" },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  },
  "definitions": {
    "periodicity_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "if": {
        "properties": { "type": { "const": "probabilistic" } }
      },
      "then": {
        "required": ["distribution"]
      },
      "else": {
        "required": ["value"]
      }
    }
  }
}