{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventsRegistry",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["event_category"],
    "properties": {
      "event_category": { "enum": ["static", "dynamic"] }
    },   
    "if": {
      "properties": { "event_category": { "const": "static" } }
    },
    "then": {
      "required": ["signal", "agent_type", "periodicity"],
      "properties": {
        "event_category": { "type": "string" },
        "signal": { "type": "string" },
        "agent_type": { "type": "string" },
        "periodicity": { "$ref": "#/definitions/periodicity_definition" }
      }
    },
    "else": {
      "required": ["signal", "agent_id"],
      "additionalProperties": false,
      "properties": {
        "event_category": { "type": "string" },
        "signal": { "type": "string" },
        "agent_id": { "type": "string" },
        "env_id": { "type": "string" },
        "channel_id": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "required": ["channel_id"] },
          "then": { "required": ["env_id"] }
        }
      ]
    }
  },
  "definitions": {
    "periodicity_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          },
          "else": {
            "required": ["value"]
          }
        }
      ]
    }
  }
}