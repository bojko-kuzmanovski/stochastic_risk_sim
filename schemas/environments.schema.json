{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnvironmentsFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["quantity", "environment_type", "params"],
    "additionalProperties": false,
    "properties": {
      "quantity": { "type": "integer", "minimum": 1, "maximum": 10000 },
      "environment_type": { "type": "string" },
      "params": {
        "type": "object",
        "additionalProperties": { "$ref": "#/definitions/param_definition" }
      },
      "members": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["agent_id", "agent_rol"],
          "additionalProperties": false,
          "properties": {
            "agent_id": { "type": "string" },
            "agent_rol": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/param_definition" }
            }
          }
        }
      },
      "relations": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["members"],
          "additionalProperties": false,
          "properties": {
            "members": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string" }
            },
            "metadata": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/param_definition" }
            }
          }
        }
      },
      "channels": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["channel_id", "members", "events"],
          "additionalProperties": false,
          "properties": {
            "channel_id": { "type": "string" },
            "members": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "items": { "type": "string" }
            },
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["agent_id", "signal"],
                "additionalProperties": false,
                "properties": {
                  "agent_id": { "type": "string" },
                  "signal": { "type": "string" }
                }
              },
              "minItems": 0
            },
            "metadata": {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/param_definition" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "param_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" }
      },
      "additionalProperties": false,
      "if": {
        "properties": { "type": { "const": "probabilistic" } }
      },
      "then": {
        "required": ["distribution"]
      },
      "else": {
        "required": ["value"]
      }
    }
  }
}