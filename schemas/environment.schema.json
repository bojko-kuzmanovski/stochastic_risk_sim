{
  "id": {
    "type": "string",
    "required": true
  },

  "context": {
    "type": "array",
    "items": {
      "agent_id": { "type": "string", "required": true }
    },
    "constraints": [
      "unique(agent_id)"
    ]
  },

  "profile": {
    "type": "array",
    "items": {
      "agent_id": { "type": "string", "required": true },
      "is_private": { "type": "boolean", "required": true }
    },
    "constraints": [
      "unique(agent_id)"
    ]
  },

  "follow": {
    "type": "array",
    "items": {
      "from_agent_id": { "type": "string", "required": true },
      "to_agent_id": { "type": "string", "required": true },
      "is_approved": { "type": "boolean", "required": true }
    },
    "constraints": [
      "from_agent_id != to_agent_id",
      "unique(from_agent_id, to_agent_id)",
      "exists(profile.agent_id, from_agent_id)",
      "exists(profile.agent_id, to_agent_id)"
    ]
  },

  "connection": {
    "type": "array",
    "items": {
      "from_agent_id": { "type": "string", "required": true },
      "to_agent_id": { "type": "string", "required": true },
      "is_approved": { "type": "boolean", "required": true }
    },
    "constraints": [
      "from_agent_id != to_agent_id",
      "unique_undirected(from_agent_id, to_agent_id)",
      "exists(profile.agent_id, from_agent_id)",
      "exists(profile.agent_id, to_agent_id)"
    ]
  },

  "groups": {
    "type": "array",
    "items": {
      "group_id": { "type": "string", "required": true },
      "members": {
        "type": "array",
        "items": {
          "member_agent_id": { "type": "string", "required": true },
          "is_admin": { "type": "boolean", "required": true }
        },
        "min_length": 1
      }
    },
    "constraints": [
      "unique(group_id)",
      "exists(profile.agent_id, members.member_agent_id)",
      "at_least_one(members.is_admin == true)"
    ]
  },

  "direct_channels": {
    "type": "array",
    "items": {
      "channel_id": { "type": "string", "required": true },
      "members": {
        "type": "array",
        "items": "string",
        "min_length": 2,
        "max_length": 2
      }
    },
    "constraints": [
      "unique(channel_id)",
      "exists(profile.agent_id, members)"
    ]
  },

  "group_channels": {
    "type": "array",
    "items": {
      "channel_id": { "type": "string", "required": true },
      "members": {
        "type": "array",
        "items": {
          "member_agent_id": { "type": "string", "required": true }
        },
        "min_length": 1
      }
    },
    "constraints": [
      "unique(channel_id)",
      "exists(profile.agent_id, members.member_agent_id)"
    ]
  },

  "applications": {
    "type": "array",
    "items": {
      "publisher_agent_id": { "type": "string", "required": true },
      "applicants": {
        "type": "array",
        "items": {
          "applicant_agent_id": { "type": "string", "required": true }
        },
        "min_length": 0
      }
    },
    "constraints": [
      "exists(profile.agent_id, publisher_agent_id)",
      "exists(profile.agent_id, applicants.applicant_agent_id)",
      "forall(applicants.applicant_agent_id != publisher_agent_id)",
      "unique(applicants.applicant_agent_id)"
    ]
  }
}