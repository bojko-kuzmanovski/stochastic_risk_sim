{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z_][a-zA-Z0-9_]*$": {
      "type": "object",
      "properties": {
        "id_prefix": { "type": "string" },
        "params": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z_][a-zA-Z0-9_]*$": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["probabilistic", "deterministic"] },
                "distribution": { "type": "string" },
                "refs": { "type": "object", "additionalProperties": { "type": "string" } }
              },
              "required": ["type"]
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["id_prefix", "params"]
    }
  },
  "additionalProperties": false
}