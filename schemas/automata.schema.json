{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomataFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["automaton_name", "states", "params", "transitions"],
    "properties": {
      "automaton_name": { "type": "string" },
      "states": {
        "type": "object",
        "required": ["initial", "final"],
        "properties": {
          "initial": { "type": "string" },
          "final": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": { "$ref": "#/definitions/dynamic_value" }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/definitions/transition" }
      }
    }
  },

  "definitions": {
    "transition": {
      "type": "object",
      "required": ["from", "threshold_value", "thresholds"],
      "properties": {
        "from": { "type": "string" },
        "threshold_value": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/dynamic_value" }
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_cases" }
        }
      }
    },

    "threshold_rule": {
      "type": "object",
      "required": ["variable", "operator", "value"],
      "properties": {
        "variable": { "$ref": "#/definitions/ephemeral_variable" },
        "operator": { "type": "string", "enum": ["<", "<=", ">", ">=", "==", "!="] },
        "value": { "type": ["string", "number", "boolean", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["<", "<=", ">", ">="] }
            }
          },
          "then": {
            "properties": {
              "value": { "type": "number" }
            }
          }
        }
      ]
    },

    "threshold_cases": {
      "type": "object",
      "required": ["threshold_case", "to"],
      "properties": {
        "threshold_case": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/definitions/threshold_rule" }
        },
        "to": { "type": "string" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "event_emit": { "$ref": "#/definitions/event_emit_object" },
              "action_required": { "type": "object", "additionalProperties": { "$ref": "#/definitions/logic" } },
              "update_params": { "type": "object", "additionalProperties": { "$ref": "#/definitions/dynamic_value" } }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },

    "event_emit_object": {
      "type": "array",
      "enum": [
        ["signal", "agent_id"],
        ["signal", "agent_id", "env_id"],
        ["signal", "agent_id", "env_id", "channel_id"]
      ]
    },

    "logic": {
      "type": "object",
      "required": ["target", "method"],
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "enum": ["events", "agents", "environments", "system"] },
        "method": { "type": "string" },
        "params": { }
      },
      "allOf": [
        {
          "if": { "properties": { "target": { "const": "events" } } },
          "then": {
            "required": ["method"],
            "properties": {
              "method": { "enum": ["event_signal", "event_agent_id", "event_env_id", "event_channel_id"] },
              "params": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "target": { "const": "agents" } } },
          "then": {
            "required": ["method", "params"],
            "properties": { "method": { "enum": ["get_all_agents", "add_agent", "remove_agent", "read_agent_param", "write_agent_param"] }, "params": { "type": "array" } },
            "allOf": [
              { "if": { "properties": { "method": { "const": "get_all_agents" } } }, "then": { "properties": { "params": { "enum": [["agent_type"]] } } } },
              { "if": { "properties": { "method": { "const": "add_agent" } } }, "then": { "properties": { "params": { "enum": [["agent_type"]] } } } },
              { "if": { "properties": { "method": { "const": "remove_agent" } } }, "then": { "properties": { "params": { "enum": [["agent_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_agent_param" } } }, "then": { "properties": { "params": { "enum": [["agent_id", "param_key"]] } } } },
              { "if": { "properties": { "method": { "const": "write_agent_param" } } }, "then": { "properties": { "params": { "enum": [["agent_id", "param_key", "value"]] } } } }
            ]
          }
        },
        {
          "if": { "properties": { "target": { "const": "environments" } } },
          "then": {
            "required": ["method", "params"],
            "properties": {  "method": { "enum": ["get_all_envs", "add_env", "remove_env", "read_env_param", "write_env_param", "read_members", "write_member", "read_member_param", "write_member_param", "read_rel", "add_rel", "remove_rel", "read_rel_param", "write_rel_param", "read_ch", "add_ch", "remove_ch", "read_ch_members", "write_ch_member", "read_ch_param", "write_ch_param", "read_ch_events", "write_ch_event"] }, "params": { "type": "array" } },
            "allOf": [
              { "if": { "properties": { "method": { "const": "get_all_envs" } } }, "then": { "properties": { "params": { "enum": [["env_type"]] } } } },
              { "if": { "properties": { "method": { "const": "add_env" } } }, "then": { "properties": { "params": { "enum": [["env_type"]] } } } },
              { "if": { "properties": { "method": { "const": "remove_env" } } }, "then": { "properties": { "params": { "enum": [["env_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_env_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "param_key"]] } } } },
              { "if": { "properties": { "method": { "const": "write_env_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "param_key", "value"]] } } } },
              { "if": { "properties": { "method": { "const": "read_members" } } }, "then": { "properties": { "params": { "enum": [["env_id"]] } } } },
              { "if": { "properties": { "method": { "const": "write_member" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_member_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_id", "param_key"]] } } } },
              { "if": { "properties": { "method": { "const": "write_member_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_id", "param_key", "value"]] } } } },
              { "if": { "properties": { "method": { "const": "read_rel" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_a_id", "agent_b_id"]] } } } },
              { "if": { "properties": { "method": { "const": "add_rel" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_a_id", "agent_b_id"]] } } } },
              { "if": { "properties": { "method": { "const": "remove_rel" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_a_id", "agent_b_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_rel_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_a_id", "agent_b_id", "param_key"]] } } } },
              { "if": { "properties": { "method": { "const": "write_rel_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "agent_a_id", "agent_b_id", "param_key", "value"]] } } } },
              { "if": { "properties": { "method": { "const": "read_ch" } } }, "then": { "properties": { "params": { "enum": [["env_id"]] } } } },
              { "if": { "properties": { "method": { "const": "add_ch" } } }, "then": { "properties": { "params": { "enum": [["env_id"]] } } } },
              { "if": { "properties": { "method": { "const": "remove_ch" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_ch_members" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id"]] } } } },
              { "if": { "properties": { "method": { "const": "write_ch_member" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id", "agent_id"]] } } } },
              { "if": { "properties": { "method": { "const": "read_ch_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id", "param_key"]] } } } },
              { "if": { "properties": { "method": { "const": "write_ch_param" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id", "param_key", "value"]] } } } },
              { "if": { "properties": { "method": { "const": "read_ch_events" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id"]] } } } },
              { "if": { "properties": { "method": { "const": "write_ch_event" } } }, "then": { "properties": { "params": { "enum": [["env_id", "channel_id", "agent_id", "signal"]] } } } }
            ]
          }
        },
        {
          "if": { "properties": { "target": { "const": "system" } } },
          "then": {
            "required": ["method", "params"],
            "properties": {
              "method": { "enum": ["math_pipeline"] },
              "params": {
                "type": "object",
                "required": ["initial_value", "operations"],
                "additionalProperties": false,
                "properties": {
                  "initial_value": {
                    "oneOf": [
                      { "$ref": "#/definitions/dynamic_value" },
                      { "$ref": "#/definitions/ephemeral_variable" }
                    ]
                  },
                  "operations": {
                    "type": "array",
                    "minItems": 0,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "required": ["operator"],
                      "additionalProperties": false,
                      "properties": {
                        "operator": { "enum": ["+", "-", "*", "/", "ceil", "floor", "max", "min"] },
                        "with": {
                          "oneOf": [
                            { "$ref": "#/definitions/dynamic_value" },
                            { "$ref": "#/definitions/ephemeral_variable" }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },

    "param_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          },
          "else": {
            "required": ["value"]
          }
        }
      ]
    },
    
    "ephemeral_variable": {
      "type": "string",
      "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$"
    },

    "dynamic_value": {
      "oneOf": [
        { "$ref": "#/definitions/param_definition" },
        { "$ref": "#/definitions/logic" }
      ]
    }
  }
}