{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomataFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["automaton_name", "states", "params", "transitions"],
    "properties": {
      "automaton_name": { "type": "string" },
      "states": {
        "type": "object",
        "required": ["initial", "final"],
        "properties": {
          "initial": { "type": "string" },
          "final": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/param_value"
        }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/definitions/transition" }
      }
    }
  },
  "definitions": {
    "transition": {
      "type": "object",
      "required": ["from", "threshold_value", "thresholds"],
      "properties": {
        "from": { "type": "string" },
        "threshold_value": {
          "$ref": "#/definitions/param_value"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_cases" }
        }
      }
    },
    "threshold_condition": {
      "type": "object",
      "required": ["operator", "value"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": ["<", "<=", ">", ">=", "==", "!="]
        },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["<", "<=", ">", ">="] }
            }
          },
          "then": {
            "properties": {
              "value": { "type": "number" }
            }
          }
        }
      ]
    },
    "threshold_cases": {
      "type": "object",
      "required": ["threshold_case", "to"],
      "properties": {
        "threshold_case": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_condition" }
        },
        "to": { "type": "string" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "event_emit": { "$ref": "#/definitions/event_emit_object" },
              "action_required": { "$ref": "#/definitions/action_required_object" },
              "update_params": {
                "type": "object",
                "additionalProperties": { "$ref": "#/definitions/param_value" }
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },
    "event_emit_object": {
      "type": "object",
      "required": ["signal", "to_agent_id"],
      "properties": {
        "signal": { "type": "string" },
        "to_agent_id": { "type": "string" },
        "env_id": { "type": "string" },
        "channel_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "action_required_object": {
      "type": "object",
      "required": ["target", "method", "params"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["agents", "environments"]
        },
        "method": {
          "type": "string",
          "enum": [
            "add_agent",
            "remove_agent",
            "write_agent_param",

            "add_env",
            "remove_env",
            "write_env_param",
            "write_member",
            "write_member_param",
            "add_rel",
            "remove_rel",
            "write_rel_metadata",
            "add_ch",
            "remove_ch",
            "write_ch_member",
            "write_ch_param",
            "write_ch_event"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "query_object": {
      "type": "object",
      "required": ["target", "method", "params"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["agents", "environments"]
        },
        "method": {
          "type": "string",
          "enum": [
            "get_all_agents",
            "read_agent_param",

            "get_all_envs",
            "read_env_param",
            "read_members",
            "read_member_param",
            "read_rel",
            "read_rel_metadata",
            "read_ch",
            "read_ch_members",
            "read_ch_param",
            "read_ch_events"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "param_value": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic", "logic"] },

        "value": { "type": ["string", "number", "boolean", "null"] },

        "distribution": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },

        "query": {
          "$ref": "#/definitions/query_object"
        }
      },
      "additionalProperties": false,

      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "deterministic" } }
          },
          "then": {
            "required": ["value"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "logic" } }
          },
          "then": {
            "required": ["query"]
          }
        }
      ]
    }
  }
}