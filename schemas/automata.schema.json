{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomataFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["automaton_name", "states", "params", "transitions"],
    "properties": {
      "automaton_name": { "type": "string" },
      "states": {
        "type": "object",
        "required": ["initial", "final"],
        "properties": {
          "initial": { "type": "string" },
          "final": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/param_value"
        }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/definitions/transition" }
      }
    }
  },
  "definitions": {
    "transition": {
      "type": "object",
      "required": ["from", "rule", "thresholds"],
      "properties": {
        "from": { "type": "string" },
        "rule": {
          "$ref": "#/definitions/param_value"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_case" }
        }
      }
    },
    "threshold_case": {
      "type": "object",
      "required": ["threshold", "to", "effect_order"],
      "properties": {
        "threshold": { "type": "string" },
        "to": { "type": "string" },
        "event_emit": {
          "$ref": "#/definitions/event_emit_object"
        },
        "action_required": {
          "$ref": "#/definitions/action_required_object"
        },
        "update_params": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/param_value"
          }
        },
        "effect_order": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["event_emit", "action_required", "update_params"]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": { "required": ["event_emit"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "event_emit" }
              }
            }
          }
        },
        {
          "if": { "required": ["action_required"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "action_required" }
              }
            }
          }
        },
        {
          "if": { "required": ["update_params"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "update_params" }
              }
            }
          }
        },
        {
          "if": {
            "required": ["effect_order"],
            "properties": {
              "effect_order": {
                "contains": { "const": "event_emit" }
              }
            }
          },
          "then": {
            "required": ["event_emit"]
          }
        },
        {
          "if": {
            "required": ["effect_order"],
            "properties": {
              "effect_order": {
                "contains": { "const": "action_required" }
              }
            }
          },
          "then": {
            "required": ["action_required"]
          }
        },
        {
          "if": {
            "required": ["effect_order"],
            "properties": {
              "effect_order": {
                "contains": { "const": "update_params" }
              }
            }
          },
          "then": {
            "required": ["update_params"]
          }
        }
      ]
    },
    "event_emit_object": {
      "type": "object",
      "required": ["signal", "params"],
      "properties": {
        "signal": { "type": "string" },
        "params": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "action_required_object": {
      "type": "object",
      "required": ["target", "method", "params"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["agents", "environments"]
        },
        "method": {
          "type": "string",
          "enum": [
            "set_param", 
            "profile_register", 
            "profile_private_change", 
            "follow_request",
            "follow_reject",
            "follow_accept",
            "connection_request",
            "connection_reject",
            "connection_accept",
            "direct_channels_interact",
            "group_channels_register",
            "group_channels_delete",
            "group_channels_agent_delete",
            "group_channels_join",
            "group_channels_interact",
            "applications_create",
            "applications_apply"
          ]
        },
        "params": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "query_object": {
      "type": "object",
      "required": ["target", "method", "params"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["agents", "environments"]
        },
        "method": {
          "type": "string",
          "enum": [
            "get_param",
            "get_env_ids_by_type",
            "profile_already_registered"
          ]
        },
        "params": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "param_value": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic", "logic"] },

        "value": { "type": ["string", "number", "boolean"] },

        "distribution": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },

        "query": {
          "$ref": "#/definitions/query_object"
        }
      },
      "additionalProperties": false,

      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "deterministic" } }
          },
          "then": {
            "required": ["value"]
          }
        },
        {
          "if": {
            "properties": { "type": { "const": "logic" } }
          },
          "then": {
            "required": ["query"]
          }
        }
      ]
    }
  }
}