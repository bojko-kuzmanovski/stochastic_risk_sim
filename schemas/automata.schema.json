{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomataFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["automaton_name", "states", "params", "transitions"],
    "properties": {
      "automaton_name": { "type": "string" },
      "states": {
        "type": "object",
        "required": ["initial", "final"],
        "properties": {
          "initial": { "type": "string" },
          "final": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["probabilistic", "deterministic"] },
            "value": { "type": ["string", "number", "boolean"] },
            "distribution": { "type": "string" },
            "refs": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          },
          "else": {
            "required": ["value"]
          }
        }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/definitions/transition" }
      }
    }
  },
  "definitions": {
    "threshold_case": {
      "type": "object",
      "required": ["threshold", "to", "effect_order"],
      "properties": {
        "threshold": { "type": "string" },
        "to": { "type": "string" },

        "action_required": { "type": "string" },
        "event_emit": { "type": "string" },

        "update": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["probabilistic", "deterministic"] },
              "value": { "type": ["string", "number", "boolean"] },
              "distribution": { "type": "string" },
              "refs": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              }
            },
            "if": {
              "properties": { "type": { "const": "probabilistic" } }
            },
            "then": {
              "required": ["distribution"]
            },
            "else": {
              "required": ["value"]
            }
          }
        },

        "effect_order": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["update", "event_emit", "action_required"]
          },
          "minItems": 0,
          "maxItems": 3,
          "uniqueItems": true
        }

      },
      "allOf": [
        {
          "if": { "required": ["update"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "update" }
              }
            }
          }
        },
        {
          "if": { "required": ["event_emit"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "event_emit" }
              }
            }
          }
        },
        {
          "if": { "required": ["action_required"] },
          "then": {
            "properties": {
              "effect_order": {
                "contains": { "const": "action_required" }
              }
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["from", "type", "thresholds"],
      "properties": {
        "from": { "type": "string" },
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" },
        "refs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_case" }
        }
      },
      "if": {
        "properties": { "type": { "const": "probabilistic" } }
      },
      "then": {
        "required": ["distribution"]
      },
      "else": {
        "required": ["value"]
      }
    }
  }
}