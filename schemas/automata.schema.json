{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutomataFactory",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["automaton_name", "states", "params", "transitions"],
    "properties": {
      "automaton_name": { "type": "string" },
      "states": {
        "type": "object",
        "required": ["initial", "final"],
        "properties": {
          "initial": { "type": "string" },
          "final": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "params": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/definitions/param_definition"
        }
      },
      "transitions": {
        "type": "array",
        "items": { "$ref": "#/definitions/transition" }
      }
    }
  },

  "definitions": {
    "transition": {
      "type": "object",
      "required": ["from", "threshold_value", "thresholds"],
      "properties": {
        "from": { "type": "string" },
        "threshold_value": {
          "$ref": "#/definitions/dynamic_value"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_cases" }
        }
      }
    },

    "threshold_condition": {
      "type": "object",
      "required": ["operator", "value"],
      "properties": {
        "operator": {
          "type": "string",
          "enum": ["<", "<=", ">", ">=", "==", "!="]
        },
        "value": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["<", "<=", ">", ">="] }
            }
          },
          "then": {
            "properties": {
              "value": { "type": "number" }
            }
          }
        }
      ]
    },

    "threshold_cases": {
      "type": "object",
      "required": ["threshold_case", "to"],
      "properties": {
        "threshold_case": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/threshold_condition" }
        },
        "to": { "type": "string" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1,
            "properties": {
              "event_emit": { "$ref": "#/definitions/event_emit_object" },
              "action_required": { "$ref": "#/definitions/query_object" },
              "update_params": {
                "type": "object",
                "additionalProperties": { "$ref": "#/definitions/dynamic_value" }
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 20
        }
      }
    },

    "event_emit_object": {
      "type": "object",
      "required": ["signal", "agent_id"],
      "additionalProperties": false,
      "properties": {
        "signal": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/definitions/dynamic_value" }
          ]
        },
        "agent_id": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/definitions/dynamic_value" }
          ]
        },
        "env_id": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/definitions/dynamic_value" }
          ]
        },
        "channel_id": {
          "anyOf": [
            { "type": "string" },
            { "$ref": "#/definitions/dynamic_value" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "required": ["channel_id"] },
          "then": { "required": ["env_id"] }
        }
      ]
    },

    "query_object": {
      "type": "object",
      "required": ["target", "method", "params", "returns"],
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": ["events", "agents", "environments", "system"]
        },
        "method": { "type": "string" },
        "params": { "type": "object" },
        "returns": {
          "type": "object",
          "required": ["variable", "type"],
          "additionalProperties": false,
          "properties": { 
            "variable": { "type": "string" }, 
            "type": { "type": "string" } 
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "target": { "const": "events" } } },
          "then": {
            "properties": {
              "method": {
                "enum": ["read_event_signal", "read_event_agent_id", "read_event_env_id", "read_event_channel_id"]
              },
              "params": { "type": "object", "properties": {}, "additionalProperties": false },
              "returns": { "properties": { "type": { "enum": ["string", "null"] } } }
            }
          }
        },
        {
          "if": { "properties": { "target": { "const": "agents" } } },
          "then": {
            "properties": { "method": { "enum": ["get_all_agents", "add_agent", "remove_agent", "read_agent_param", "write_agent_param"] } },
            "allOf": [
              { "if": { "properties": { "method": { "const": "get_all_agents" } } }, "then": { "properties": { "params": { "type": "object", "required": ["agent_type"], "additionalProperties": false, "properties": { "agent_type": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string_array"] } } } } } },
              { "if": { "properties": { "method": { "const": "add_agent" } } }, "then": { "properties": { "params": { "type": "object", "required": ["agent_type"], "additionalProperties": false, "properties": { "agent_type": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "remove_agent" } } }, "then": { "properties": { "params": { "type": "object", "required": ["agent_id"], "additionalProperties": false, "properties": { "agent_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_agent_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["agent_id", "param_name"], "additionalProperties": false, "properties": { "agent_id": { "type": "string" }, "param_name": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "number", "boolean", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_agent_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["agent_id", "param_name", "value"], "additionalProperties": false, "properties": { "agent_id": { "type": "string" }, "param_name": { "type": "string" }, "value": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/dynamic_value" } ] } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } }
            ]
          }
        },
        {
          "if": { "properties": { "target": { "const": "environments" } } },
          "then": {
            "properties": { "method": { "enum": ["get_all_envs", "add_env", "remove_env", "read_env_param", "write_env_param", "read_members", "write_member", "read_member_param", "write_member_param", "read_rel", "add_rel", "remove_rel", "read_rel_param", "write_rel_param", "read_ch", "add_ch", "remove_ch", "read_ch_members", "write_ch_member", "read_ch_param", "write_ch_param", "read_ch_events", "write_ch_event"] } },
            "allOf": [
              { "if": { "properties": { "method": { "const": "get_all_envs" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_type"], "additionalProperties": false, "properties": { "env_type": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string_array"] } } } } } },
              { "if": { "properties": { "method": { "const": "add_env" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_type"], "additionalProperties": false, "properties": { "env_type": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "remove_env" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_env_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "param_name"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "param_name": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "number", "boolean", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_env_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "param_name", "value"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "param_name": { "type": "string" }, "value": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/dynamic_value" } ] } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_members" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string_array", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_member" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_member_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_id", "param_name"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_id": { "type": "string" }, "param_name": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "number", "boolean", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_member_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_id", "param_name", "value"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_id": { "type": "string" }, "param_name": { "type": "string" }, "value": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/dynamic_value" } ] } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_rel" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_a_id", "agent_b_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_a_id": { "type": "string" }, "agent_b_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "add_rel" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_a_id", "agent_b_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_a_id": { "type": "string" }, "agent_b_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "remove_rel" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_a_id", "agent_b_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_a_id": { "type": "string" }, "agent_b_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_rel_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_a_id", "agent_b_id", "param_name"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_a_id": { "type": "string" }, "agent_b_id": { "type": "string" }, "param_name": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "number", "boolean", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_rel_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "agent_a_id", "agent_b_id", "param_name", "value"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "agent_a_id": { "type": "string" }, "agent_b_id": { "type": "string" }, "param_name": { "type": "string" }, "value": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/dynamic_value" } ] } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_ch" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string_array", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "add_ch" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "remove_ch" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_ch_members" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string_array", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_ch_member" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id", "agent_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" }, "agent_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_ch_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id", "param_name"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" }, "param_name": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["string", "number", "boolean", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_ch_param" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id", "param_name", "value"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" }, "param_name": { "type": "string" }, "value": { "anyOf": [ { "type": ["string", "number", "boolean", "null"] }, { "$ref": "#/definitions/dynamic_value" } ] } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } },
              { "if": { "properties": { "method": { "const": "read_ch_events" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["event_array", "null"] } } } } } },
              { "if": { "properties": { "method": { "const": "write_ch_event" } } }, "then": { "properties": { "params": { "type": "object", "required": ["env_id", "channel_id", "agent_id", "signal"], "additionalProperties": false, "properties": { "env_id": { "type": "string" }, "channel_id": { "type": "string" }, "agent_id": { "type": "string" }, "signal": { "type": "string" } } }, "returns": { "properties": { "type": { "enum": ["boolean"] } } } } } }
            ]
          }
        },
        {
          "if": { "properties": { "target": { "const": "system" } } },
          "then": {
            "properties": {
              "method": { "enum": ["math_pipeline"] },
              "params": {
                "type": "object",
                "required": ["initial_value", "operations"],
                "additionalProperties": false,
                "properties": {
                  "initial_value": { "$ref": "#/definitions/dynamic_value" },
                  "operations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["operator"],
                      "additionalProperties": false,
                      "properties": {
                        "operator": { "enum": ["add", "subtract", "multiply", "divide", "ceil", "floor", "max", "min"] },
                        "with": { "$ref": "#/definitions/dynamic_value" }
                      }
                    }
                  }
                }
              },
              "returns": { "properties": { "type": { "enum": ["number"] } } }
            }
          }
        }
      ]
    },

    "param_definition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["probabilistic", "deterministic"] },
        "value": { "type": ["string", "number", "boolean"] },
        "distribution": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "probabilistic" } }
          },
          "then": {
            "required": ["distribution"]
          },
          "else": {
            "required": ["value"]
          }
        }
      ]
    },
    
    "dynamic_value": {
      "oneOf": [
        { "$ref": "#/definitions/param_definition" },
        { "$ref": "#/definitions/query_object" },
        { "type": "string", "pattern": "^\\$[a-zA-Z_][a-zA-Z0-9_]*$" }
      ]
    }
  }
}